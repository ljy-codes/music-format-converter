<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MusicFormatConverter.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="CanvasBrush" Color="#0C1425"/>
          <SolidColorBrush x:Key="PanelBrush" Color="#141F34"/>
          <SolidColorBrush x:Key="InsetBrush" Color="#101A2E"/>
          <SolidColorBrush x:Key="StrokeBrush" Color="#2A3953"/>
          <SolidColorBrush x:Key="TextBrush" Color="#F0F4FC"/>
          <SolidColorBrush x:Key="MutedBrush" Color="#ACBDD5"/>
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#203B67"/>
          <SolidColorBrush x:Key="AccentTextBrush" Color="#A8CDFF"/>
          <SolidColorBrush x:Key="WarningBrush" Color="#FFD08A"/>
          <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#352D25"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="CanvasBrush" Color="#EFF3FA"/>
          <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="InsetBrush" Color="#F5F8FD"/>
          <SolidColorBrush x:Key="StrokeBrush" Color="#D6DFED"/>
          <SolidColorBrush x:Key="TextBrush" Color="#17253E"/>
          <SolidColorBrush x:Key="MutedBrush" Color="#53647D"/>
          <SolidColorBrush x:Key="AccentSoftBrush" Color="#E7F0FF"/>
          <SolidColorBrush x:Key="AccentTextBrush" Color="#215CB5"/>
          <SolidColorBrush x:Key="WarningBrush" Color="#80510A"/>
          <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FFF3DA"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#4D91FF"/>
        <ColorPaletteResources x:Key="Light" Accent="#2563D9"/>
      </FluentTheme.Palettes>
    </FluentTheme>
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource CanvasBrush}"/>
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Padding" Value="15,8"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#2563D9"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#3478EF"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#1D4CAB"/>
    </Style>
    <Style Selector="Button.primary:disabled">
      <Setter Property="Opacity" Value="0.48"/>
    </Style>
    <Style Selector="Button.quiet">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="MinHeight" Value="38"/>
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="MinHeight" Value="42"/>
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="MinHeight" Value="36"/>
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="10,9"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="ToolTip">
      <Setter Property="MaxWidth" Value="680"/>
    </Style>
  </Application.Styles>
</Application>
